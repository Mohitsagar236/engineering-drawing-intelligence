# Local SQLite URL. Compose overrides it to the persistent /app/data volume.
DATABASE_URL=sqlite:///./ed.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
MAX_PAGES=50
MAX_IMAGE_PIXELS=25000000
RENDER_DPI=180
OCR_ENGINE=easyocr
OCR_LANGUAGES=en
OCR_MIN_CONFIDENCE=0.90
PROCESSING_TIMEOUT=600
CORS_ORIGINS=http://localhost:3000
# Set production and a long password before sharing the application.
ENVIRONMENT=development
AUTH_USERNAME=reviewer
AUTH_PASSWORD=
